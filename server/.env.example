# 复制成 .env 再填。.env 不要提交
YJ_SECRET=换成随机的长字符串，例如 openssl rand -hex 32 的结果
# YJ_DATABASE_URL=postgresql+psycopg://yuanjing:密码@数据库地址:5432/yuanjing
# YJ_TZ=Asia/Shanghai
# 正式环境关掉演示会员开关，会员只能由苹果内购开通
# YJ_DEMO_MEMBERSHIP=0
# 正式环境不要示例用户
# YJ_SEED_DEMO=0
# 大模型（OpenAI 兼容接口），三项都填才启用
YJ_LLM_BASE_URL=
YJ_LLM_API_KEY=
YJ_LLM_MODEL=
