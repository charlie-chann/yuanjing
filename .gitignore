# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# 免费素材库（很大，按需从 tools/sanctuary/fetch_library.py 重新下载）
/asset_library/


# Python 虚拟环境（tools/tts 下的本地语音模型环境很大）
.venv/

# Unity：工程缓存和导出产物（unity/export.sh 会重新生成 ios/unityLibrary）
/unity/Sanctuary/Library/
/unity/Sanctuary/Temp/
/unity/Sanctuary/Logs/
/unity/Sanctuary/UserSettings/
/unity/Sanctuary/obj/
/unity/Sanctuary/*.csproj
/unity/Sanctuary/*.sln
/unity/thirdparty/
/unity/shots/
/unity/test.xml
/ios/unityLibrary/

# Blender 出的预览图（tools/blender/build_all.sh 会重新生成）
/tools/blender/preview/

# Unity 测试运行中断时留下的临时场景
/unity/Sanctuary/Assets/InitTestScene*
